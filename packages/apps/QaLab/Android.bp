// QaLab — the only first-party app that ships with qalos.
//
// Platform-signed (so it can read @hide system_server APIs via
// IActivityManager), single-activity launcher that prints build
// metadata at startup. Replaces the legacy Android.mk which AOSP 15
// deprecated.
//
// Note: the legacy `LOCAL_MODULE_TAGS := optional` had no direct
// bp equivalent. Soong derives tag visibility from the module name
// and the build target, so the `tags:` property is omitted entirely.

android_app {
    name: "QaLab",

    // Install into the product partition, not system.
    //
    // Pixel products (pantah/cheetah) use a system/product/system_ext split and
    // enforce it: build/make/core/artifact_path_requirements.mk rejects any
    // module that drops a file into system/ without a matching entry in
    // build/make/target/product/generic_system.mks. With no such entry this
    // fails the build at the end of soong bootstrap:
    //
    //   artifact_path_requirements.mk:31: error: device/qalos/qalos_cheetah/
    //     qalos_cheetah.mk produces files inside generic_system.mks artifact
    //     path requirement.
    //   Offending entries:
    //   system/app/QaLab/QaLab.apk
    //
    // product_specific: true moves the APK to product/app/QaLab/. This is the
    // same property upstream uses for the same reason -- see
    // packages/apps/Camera2/Android.bp and pantah's overlay_packages/*.Android.bp
    // (device/google/pantah/panther/overlay_packages/*/Android.bp:7).
    product_specific: true,

    // `LOCAL_CERTIFICATE := platform` in the old Android.mk.
    certificate: "platform",

    // `LOCAL_PRIVATE_PLATFORM_APIS := true` in the old Android.mk.
    // `sdk_version: "current"` compiles against the system image at
    // runtime, granting the @hide API access that the old flag did.
    sdk_version: "current",

    srcs: ["src/**/*.java"],

    // AndroidManifest.xml is auto-discovered when it lives next to
    // Android.bp in the same directory, so no explicit `manifest:`
    // line is needed.
}
