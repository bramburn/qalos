// QaLab — the only first-party app that ships with qalos.
//
// Platform-signed (so it can read @hide system_server APIs via
// IActivityManager), single-activity launcher that prints build
// metadata at startup. Replaces the legacy Android.mk which AOSP 15
// deprecated.
//
// Note: the legacy `LOCAL_MODULE_TAGS := optional` had no direct
// bp equivalent. Soong derives tag visibility from the module name
// and the build target, so the `tags:` property is omitted entirely.

android_app {
    name: "QaLab",

    // `LOCAL_CERTIFICATE := platform` in the old Android.mk.
    certificate: "platform",

    // `LOCAL_PRIVATE_PLATFORM_APIS := true` in the old Android.mk.
    // `sdk_version: "current"` compiles against the system image at
    // runtime, granting the @hide API access that the old flag did.
    sdk_version: "current",

    srcs: ["src/**/*.java"],

    // AndroidManifest.xml is auto-discovered when it lives next to
    // Android.bp in the same directory, so no explicit `manifest:`
    // line is needed.
}
