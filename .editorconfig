# EditorConfig is awesome: https://EditorConfig.org
# One config file, every editor. Matches the AGENTS.md code style.

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false   # markdown: two trailing spaces = hard line break

[*.{json,yml,yaml}]
indent_size = 2

[*.{xml,html}]
indent_size = 2

[Makefile]
indent_style = tab
