{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 52428800
  },
  "ignore": {
    "useGitignore": false,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".worktrees/**",
      ".tmp/**",
      "aosp-source*.tar*",
      "*-partial*.tar.gz",
      "test_*.bin",
      "test_dl.bin",
      "commit-msg.txt",
      "diag*.sh",
      "find-error*.sh",
      "fix-permission.sh",
      "inspect.sh",
      "probe.py",
      "remote-ircontrol-fix.sh",
      "resume*.sh",
      "add-namespace.sh",
      "*.log",
      "*.log.err",
      ".pi/**/aliyun-*password*.txt",
      ".pi/**/*password*.txt",
      ".pi/**/*credentials*",
      ".pi/**/*credentials.*",
      ".pi/**/aws_*",
      ".pi/**/*ssh*",
      ".pi/**/keys*",
      ".pi/**/.env",
      ".pi/**/.env.*",
      ".pi/**/*s3*.sh",
      ".pi/**/*aws*.sh",
      ".pi/**/*AWS*.sh",
      "*.bak",
      "*.orig",
      "*.rej",
      "*.swp",
      "*.swo",
      ".DS_Store",
      "Thumbs.db",
      "desktop.ini",
      "node_modules/**",
      "vendor/**",
      "out/**",
      ".ccache/**",
      "build/**",
      "dist/**",
      ".idea/**",
      ".vscode/**",
      "local.properties",
      "qalos-repomix.md",
      "*.iml",
      "*.o",
      "*.so",
      "*.a",
      "*.d",
      "*.elf",
      "*.img",
      "*.zip"
    ]
  },
  "output": {
    "filePath": "qalos-repomix.md",
    "style": "markdown",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 10,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "includeEmptyDirectories": false
  },
  "include": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.sh",
    "**/*.bash",
    "**/*.py",
    "**/*.ps1",
    "**/*.bat",
    "**/*.cmd",
    "**/*.js",
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.go",
    "**/*.rs",
    "**/*.java",
    "**/*.kt",
    "**/*.kts",
    "**/*.gradle",
    "**/*.xml",
    "**/*.aconfig",
    "**/*.proto",
    "**/*.aidl",
    "**/*.rb",
    "**/*.sql",
    "**/*.html",
    "**/*.css",
    "**/*.scss",
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
    "**/*.adoc",
    "**/*.tex",
    "**/*.gitignore",
    "**/*.gitattributes",
    "**/*.editorconfig",
    "**/*.gitkeep",
    "**/*.dockerfile",
    "**/*.containerfile",
    "**/*.service",
    "**/*.policy",
    "**/*.te",
    "**/*.fc",
    "**/*.if",
    "**/*.token",
    "**/*.conf",
    "**/*.ini",
    "**/*.cfg",
    "**/*.rc",
    "**/*.env",
    "**/*.envrc",
    "**/*.properties",
    "**/*.defconfig",
    "**/*.bp",
    "**/*.mk",
    "**/*.txt",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "LICENSE*",
    "NOTICE*",
    "README*",
    "AGENTS.md",
    "AGENTS*.md",
    "BRANCH_PROTECTION.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "default.xml",
    "upstream.xml"
  ],
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
