# qalos — system_server allow rules for the Remote Control Service.
#
# This file is a device-specific overlay loaded via
# BOARD_VENDOR_SEPOLICY_DIRS (vendor/qalos/qalos_emulator/sepolicy/) in
# BoardConfig.mk. The rules here are appended to (not replacing) the
# upstream AOSP system_server.te.

# Allow system_server to create / bind / listen / accept on its own TCP
# socket for the qalos Remote Control Service. Java's ServerSocket
# also reads and writes socket options (getopt / setopt / getattr) so
# include those.
allow system_server self:tcp_socket { create bind listen accept read write getattr getopt setopt };

# `name_bind` and `node_bind` apply to port / node types respectively,
# NOT to self:tcp_socket. Without these the kernel denies the bind()
# to 127.0.0.1:9000 with:
#   avc: denied { name_bind } for ... scontext=u:r:system_server:s0
#   tcontext=u:object_r:port:s0 tclass=tcp_socket
allow system_server node:tcp_socket node_bind;
allow system_server port:tcp_socket name_bind;

# Allow system_server to register the service with the ServiceManager
# (v1+ when the AIDL is re-introduced and the service is published
# over Binder). No-op in v0 because the AIDL is gone.
allow system_server qalos_remote_control:service_manager { add find };
