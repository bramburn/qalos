<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!--
    qalos — QA Lab Operating System
    Manifest of the qalos fork. Pins AOSP to android-15.0.0_r1 (stable, ~80 GB source)
    and adds qalos-specific projects.

    Usage on a Linux build host:
      repo init -u https://github.com/bramburn/qalos -b main
      repo sync -c -j$(nproc)
      ./tools/apply-qalos.sh
      . build/envsetup.sh
      lunch qalos_emulator-userdebug
      m -j$(nproc)
  -->

  <!--
    `aosp` remote: defined here with an absolute fetch URL so it resolves
    to the actual AOSP git server regardless of where this manifest is
    hosted. The `upstream.xml` include USED to define this remote with
    `fetch=".."` (verbatim from AOSP's own default.xml), but `..` resolves
    relative to the manifest URL, so under qalos (`https://github.com/bramburn/qalos.git`)
    it pointed to `https://github.com/bramburn/` and every `repo sync` tried
    to fetch AOSP source from this fork. We removed the duplicate from
    upstream.xml; this is now the only definition.

    `qalos` remote: kept for future use — when we start adding qalos-
    specific projects via <project remote="qalos"> entries, they'll fetch
    from this fetch URL.
  -->
  <remote name="aosp" fetch="https://android.googlesource.com/" review="https://android-review.googlesource.com/" />
  <remote name="qalos" fetch="https://github.com/bramburn" />

  <default remote="aosp" revision="refs/tags/android-15.0.0_r1" sync-j="4" />

  <!--
    Pull every AOSP project at the pinned tag via the inlined upstream manifest
    in upstream.xml (a verbatim copy of
    https://android.googlesource.com/platform/manifest/+/refs/tags/android-15.0.0_r1/default.xml
    captured at this repo's commit that bumped the tag).

    We inline the upstream manifest instead of using `<include name="<url>"/>` because
    `repo`'s include resolver does not understand gitiles `+/refs/tags/...` URLs — the
    include has to point at a file in this manifest repo. Update both files together
    when bumping the AOSP tag.
  -->
  <include name="upstream.xml" />

</manifest>
