<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!--
    qalos — QA Lab Operating System
    Manifest of the qalos fork. Pins AOSP to android-15.0.0_r1 (stable, ~80 GB source)
    and adds qalos-specific projects.

    Usage on a Linux build host:
      repo init -u https://github.com/bramburn/qalos -b main
      repo sync -c -j$(nproc)
      ./tools/apply-qalos.sh
      . build/envsetup.sh
      lunch qalos_emulator-userdebug
      m -j$(nproc)
  -->

  <remote name="aosp" fetch="https://android.googlesource.com/" />
  <remote name="qalos" fetch="https://github.com/bramburn" />

  <default remote="aosp" revision="refs/tags/android-15.0.0_r1" sync-j="4" />

  <!--
    Pull every AOSP project at the pinned tag via the upstream manifest include.
    This is equivalent to `repo init -u android.googlesource.com/platform/manifest`
    but with the qalos project layered on top.
  -->
  <include name="https://android.googlesource.com/platform/manifest/+/refs/tags/android-15.0.0_r1/default.xml" />

</manifest>
